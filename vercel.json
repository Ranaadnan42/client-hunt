{
  "rewrites": [
    {
      "source": "/ap/:id",
      "destination": "/ap.html"
    },
    {
      "source": "/d/:id",
      "destination": "/demo.html"
    },
    {
      "source": "/app/:id",
      "destination": "/app.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/send",
      "destination": "/send.html"
    }
  ],
  "headers": [
    {
      "source": "/(admin|send)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}